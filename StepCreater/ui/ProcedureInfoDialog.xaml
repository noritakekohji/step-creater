<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手順書情報" Height="320" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Padding="14,4" Margin="0,0,4,0"/>
            <Button x:Name="BtnCancel" Content="キャンセル" Padding="14,4"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontWeight="Bold" Text="タイトル" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtProcTitle" Margin="0,0,0,10"/>

            <TextBlock FontWeight="Bold" Text="既定の役割" Margin="0,4,0,4"/>
            <TextBlock FontStyle="Italic" Foreground="DimGray" Margin="0,0,0,8"
                       Text="Step ごとに上書きしない限り，ここで設定した値が使われます。"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="作成者：" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtDefAuthor"   Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="確認者：" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtDefReviewer" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="実施者：" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtDefExecutor" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="再鑑者：" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtDefVerifier" Margin="0,2"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
