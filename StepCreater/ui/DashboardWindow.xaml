<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StepCreater ダッシュボード" Height="700" Width="1400"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="親フォルダ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Column="1" x:Name="TxtParentPath" IsReadOnly="True"/>
            <Button    Grid.Column="2" x:Name="BtnPickParent" Content="参照..." Padding="10,4" Margin="8,0,0,0"/>
            <Button    Grid.Column="3" x:Name="BtnRescan"     Content="再スキャン" Padding="10,4" Margin="8,0,0,0"/>
            <Button    Grid.Column="4" x:Name="BtnExportCsv"  Content="CSV出力" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="0,1,0,1"
                Background="#FAFAFA" Padding="8" Height="240">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="状態の内訳" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Canvas x:Name="PieCanvas" Width="200" Height="200"
                            Background="White"/>
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="手順書別 集計"
                               FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="SummaryGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="手順書" Binding="{Binding ProcedureTitle}" Width="180"/>
                            <DataGridTextColumn Header="計"     Binding="{Binding Total}"          Width="40"/>
                            <DataGridTextColumn Header="作成中" Binding="{Binding creating}"        Width="55"/>
                            <DataGridTextColumn Header="確認中" Binding="{Binding reviewing}"       Width="55"/>
                            <DataGridTextColumn Header="作成済" Binding="{Binding created}"         Width="55"/>
                            <DataGridTextColumn Header="実施中" Binding="{Binding executing}"       Width="55"/>
                            <DataGridTextColumn Header="再鑑中" Binding="{Binding verifying}"       Width="55"/>
                            <DataGridTextColumn Header="結果NG" Binding="{Binding ng}"              Width="55"/>
                            <DataGridTextColumn Header="中止"   Binding="{Binding aborted}"         Width="55"/>
                            <DataGridTextColumn Header="完了"   Binding="{Binding done}"            Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="DashStatus" Text="親フォルダを選択してください。"/></StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="DashGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5"
                  Margin="8,0,8,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ワークフォルダ" Binding="{Binding Workfolder}" Width="160"/>
                <DataGridTextColumn Header="手順書"         Binding="{Binding ProcedureTitle}" Width="220"/>
                <DataGridTextColumn Header="#"              Binding="{Binding StepNo}" Width="40"/>
                <DataGridTextColumn Header="Step ID"        Binding="{Binding StepId}" Width="60"/>
                <DataGridTextColumn Header="Step タイトル"  Binding="{Binding StepTitle}" Width="240"/>
                <DataGridTextColumn Header="状態"           Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="実施者"         Binding="{Binding Executor}" Width="100"/>
                <DataGridTextColumn Header="再鑑者"         Binding="{Binding Verifier}" Width="100"/>
                <DataGridTextColumn Header="開始"           Binding="{Binding Started}" Width="100"/>
                <DataGridTextColumn Header="完了"           Binding="{Binding Finished}" Width="100"/>
                <DataGridTextColumn Header="作業時間"       Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="最終更新"       Binding="{Binding Updated}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>